def split_and_keep(text, delimiter):
    result = []
    temp = ""
    for char in text:
        if char == delimiter:
            result.append(temp + char)
            temp = ""
        else:
            temp += char
    if temp:
        result.append(temp)
    return result



text = "177 g Flour unbleached egg *u000a79 g Butter *u000a33 g Almond flour *u000a480 g Apricots frozen *u000a55 g Egg *u000a103 g Milk *u000a8 g Sugar"
delimiter = " g "
result = text.replace('u000a','')

result1 = split_and_keep(result, delimiter)
result2 = result1[0].split('*')
# we know that a string with underscores has a max of three spaces. Any number larger than this means words with spaces.
#in other words 4 spaces means the 3rd has to be replaced with _ 5 spaces mean the 3rd and 4th
result3 =[]
for a in result2:
    space_indices = []
    for i, char in enumerate(a):
        if char == ' ':
            space_indices.append(i)
    
    if len(space_indices) == 4:
       na = a[:space_indices[2]] + '_' + a[space_indices[2] + 1:]
             
       result3.append(na)

    elif len(space_indices) == 5:
       na = a[:space_indices[2]] + '_' + a[space_indices[2]+1:space_indices[3]] + '_' + a[space_indices[3] + 1:]
       result3.append(na)

    else:
       result3.append(a)


