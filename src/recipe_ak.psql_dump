CREATE TABLE public.ingredients (
    name character varying(255) NOT NULL,
    energy numeric(6,3),
    protein numeric(6,3),
    carbohydrate numeric(6,3),
    sugar numeric(6,3),
    fat numeric(6,3),
    saturated numeric(6,3),
    fiber numeric(6,3),
    salt numeric(6,3),
    sodium numeric(6,3),
    portion_size numeric(6,3),
    product_source character varying(255)
);


ALTER TABLE public.ingredients OWNER TO klein;

--
-- Name: recipes; Type: TABLE; Schema: public; Owner: klein
--

CREATE TABLE public.recipes (
    id integer NOT NULL,
    name character varying(100) NOT NULL,
    portions numeric(3,1),
    energy character varying(100),
    protein character varying(100),
    carbohydrate character varying(100),
    sugar character varying(100),
    fat character varying(100),
    saturated_fat character varying(100),
    fiber character varying(100),
    salt character varying(100),
    sodium character varying(100),
    ingredients character varying(1000),
    description character varying(1000),
    "time" character varying(100),
    images character varying(1000),
    vegetarian smallint
);


ALTER TABLE public.recipes OWNER TO klein;

